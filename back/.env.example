# Conexión a PostgreSQL en NeonDB (copia este archivo a .env y pega tu URL real)
# Formato: postgresql://USUARIO:CLAVE@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=

# Puerto del servidor local de desarrollo (sirve /api/* y front/)
PORT=3000

# Orígenes permitidos para CORS (separados por coma o * en desarrollo)
CORS_ORIGIN=*
